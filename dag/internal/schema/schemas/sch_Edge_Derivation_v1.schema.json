{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primbench.example/schemas/sch_Edge_Derivation_v1.schema.json",
  "title": "sch_Edge_Derivation_v1",
  "type": "object",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/edgeBase"
    }
  ],
  "properties": {
    "schema_id": {
      "const": "sch_Edge_Derivation_v1"
    },
    "target_id": {
      "$ref": "envelope.schema.json#/$defs/nanoIdNode"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation"
      ],
      "properties": {
        "relation": {
          "type": "string",
          "enum": [
            "derived_from",
            "tagged",
            "untagged",
            "retracted",
            "governed_by",
            "cut_from",
            "deployed_as",
            "consumes",
            "produces",
            "depends_on",
            "attempt_of",
            "raised_by",
            "resolves"
          ]
        },
        "produced_by": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "served_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "role": {
          "type": "string",
          "enum": [
            "render",
            "set"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 35
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "content_type": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg"
          ]
        },
        "attached_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": [
    "target_id"
  ]
}
